{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Database": {
    "Path": "checkin.db"
  },

  "DataProtection": {
    "KeysPath": "keys"
  },

  "Telegram": {
    "BotUsername": "kafa_checkins_bot",
    "AuthMaxAgeMinutes": 1440,
    "DevLogin": false
  },

  "CheckIn": {
    "CooldownMinutes": 120
  },

  "Search": {
    "RadiusMeters": 300,
    "MaxResults": 20
  },

  "Overpass": {
    "Client": {
      "Endpoint": "https://overpass-api.de/api/interpreter",
      "RequestTimeoutSeconds": 25
    },
    "CategoriesMappings": [
      {
        "CategoryId": "cafe",
        "Filters": [ "amenity=cafe" ]
      },
      {
        "CategoryId": "restaurant",
        "Filters": [ "amenity=restaurant" ]
      }
    ]
  }
}
