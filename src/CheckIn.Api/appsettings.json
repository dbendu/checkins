{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "PlacesCategories": {
    "Categories": [
      {
        "Id": "cafe",
        "Title": "Кофейни"
      },
      {
        "Id": "restaurant",
        "Title": "Рестораны"
      }
    ]
  },

  "Search": {
    "RadiusMeters": 300,
    "MaxResults": 20
  },

  "Overpass": {
    "Client": {
      "Endpoint": "https://overpass-api.de/api/interpreter",
      "RequestTimeoutSeconds": 25
    },
    "CategoriesMappings": [
      {
        "CategoryId": "cafe",
        "Filters": [ "amenity=cafe" ]
      },
      {
        "CategoryId": "restaurant",
        "Filters": [ "amenity=restaurant" ]
      }
    ]
  }
}
